        { "change": { "op": "send", "by": "person:ana" },
          "event": { "kind": "send", "by": "person:ana", "args": 0, "version": 8, "view_rev": 1 }, "jelly": { "unsent": 0 } },
        { "change": { "op": "do", "verb": "inc", "by": "person:bo" },
          "event": { "kind": "do", "by": "person:bo", "verb": "inc", "args": null, "version": 9, "view_rev": 1 }, "jelly": { "unsent": 1 } },
