{
  "about": "Every change a shared jelly's relay makes too, with the event each makes and the jelly after it. cargo test runs these against the store (src/op.rs), npm test in relay/ against relay/src/ops.ts (relay/test/ops.test.mjs). Each case starts from a jelly t:j made by agent at version 1; `jelly` names the parts that differ from an empty one. A step either makes `event` (its kind, by, verb, args, source, quiet, version and view_rev) and leaves the jelly as `jelly` says, or is refused with exactly `refused` and changes nothing. Times (at_ms) are not compared.",
  "cases": [
    {
      "name": "a verb call changes the state and bumps the version",
      "jelly": { "verbs": "const verbs = { inc(s) { s.n = (s.n || 0) + 1; }, pick(s, { id }) { s.picked = id; }, sign(s, _a, { by }) { s.by = by; }, reset() { return { fresh: true }; } }" },
      "steps": [
        { "change": { "op": "do", "verb": "inc", "by": "agent" },
          "event": { "kind": "do", "by": "agent", "verb": "inc", "args": null, "version": 2, "view_rev": 1 },
          "jelly": { "state": { "n": 1 }, "version": 2, "unsent": 0 } },
        { "change": { "op": "do", "verb": "pick", "args": { "id": "b" }, "source": { "selector": "#b", "text": "B" }, "by": "person:ana" },
          "event": { "kind": "do", "by": "person:ana", "verb": "pick", "args": { "id": "b" }, "source": { "selector": "#b", "text": "B" }, "version": 3, "view_rev": 1 },
          "jelly": { "state": { "n": 1, "picked": "b" }, "version": 3, "unsent": 1 } },
        { "change": { "op": "do", "verb": "sign", "by": "person" },
          "event": { "kind": "do", "by": "person", "verb": "sign", "args": null, "version": 4, "view_rev": 1 },
          "jelly": { "state": { "n": 1, "picked": "b", "by": "person" }, "unsent": 2 } },
        { "change": { "op": "do", "verb": "reset", "args": {}, "by": "agent" },
          "event": { "kind": "do", "by": "agent", "verb": "reset", "args": {}, "version": 5, "view_rev": 1 },
          "jelly": { "state": { "fresh": true }, "version": 5 } }
      ]
    },
    {
      "name": "a verb that throws, is not there, or never returns changes nothing",
      "jelly": { "verbs": "const verbs = { no() { throw new Error('not now'); }, odd() { throw 'plain'; }, spin() { for (;;) {} } }", "state": { "n": 1 } },
      "steps": [
        { "change": { "op": "do", "verb": "no", "by": "person:ana" }, "refused": "not now", "jelly": { "state": { "n": 1 }, "version": 1, "unsent": 0 } },
        { "change": { "op": "do", "verb": "odd", "by": "agent" }, "refused": "plain" },
        { "change": { "op": "do", "verb": "missing", "by": "agent" }, "refused": "no verb missing; this jelly has: no, odd, spin" },
        { "change": { "op": "do", "verb": "toString", "by": "agent" }, "refused": "no verb toString; this jelly has: no, odd, spin" },
        { "change": { "op": "do", "verb": "spin", "by": "agent" }, "refused": "verb ran too long and was stopped: does it loop forever?",
          "jelly": { "state": { "n": 1 }, "version": 1, "unsent": 0 } }
      ]
    },
    {
