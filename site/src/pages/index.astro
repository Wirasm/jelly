---
import Blob from "../components/Blob.astro";

const repo = "https://github.com/Wirasm/jelly";
const description = "jelly turns what your AI agent means into a page you can click, answer and poke. Every tap goes straight back to it.";

// The demo question. Like every real jelly ask: several options, one recommended, and why.
const options = [
  { id: "dense", label: "Dense", does: "More on one screen" },
  { id: "roomy", label: "Roomy", does: "Room to breathe" },
  { id: "cards", label: "Cards", does: "One idea per card" },
];
const recommend = "roomy";
const why = "Easier to scan on a phone, where you'll read most of it.";
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>jelly · your agent can show you now</title>
  <meta name="description" content={description} />
  <meta property="og:title" content="jelly · your agent can show you now" />
  <meta property="og:description" content={description} />
  <meta property="og:url" content="https://getjellyware.com/" />
  <meta name="theme-color" content="#fff8f3" />
  <meta property="og:type" content="website" />
  <meta property="og:image" content="https://getjellyware.com/og.png" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content="The jelly blob: your agent can show you now." />
  <meta name="twitter:card" content="summary_large_image" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="alternate" type="text/plain" href="/llms.txt" title="For agents" />
</head>
<body>
  <svg width="0" height="0" style="position:absolute" aria-hidden="true">
    <defs><radialGradient id="blob-fill" cx="35%" cy="30%"><stop offset="0" stop-color="#ffb3cf" /><stop offset=".55" stop-color="#ff4f8b" /><stop offset="1" stop-color="#d81b60" /></radialGradient></defs>
  </svg>

  <div class="wrap">
    <nav>
      <a class="brand" href="/"><Blob size={34} /><span>jelly</span></a>
      <a class="nav-link" href="#install">Install</a>
      <a class="nav-link" href={repo}>GitHub</a>
    </nav>

    <header class="hero">
      <div>
        <h1>Your agent can <em>show</em> you now.</h1>
        <p class="lead">No more 900-word plans. jelly turns what your agent means into a page you can click, answer and poke. Every tap goes straight back to it.</p>
        <div class="cta">
          <a class="btn main" href="#install">Get jelly</a>
          <a class="btn ghost" href={repo}>GitHub</a>
        </div>
      </div>
      <div class="stage">
        <div class="bubble">Pick one, I'll build it 👇</div>
        <Blob size={340} class="idle big" />
      </div>
    </header>
  </div>

  <section class="band">
    <div class="wrap split">
      <div>
        <h2>Ask, tap, done.</h2>
        <p class="sub">Your agent puts a question on the exact thing it's about, with the options side by side, the one it recommends, and why. You answer in one tap, or say something else. It hears you on its next turn.</p>
      </div>
      <div class="demo" id="demo">
        <div class="term" aria-live="polite">
          <div><span class="p">agent $</span> jelly ask hero "Which layout?" \</div>
          <div>&nbsp;&nbsp;--option dense --option roomy --option cards \</div>
          <div>&nbsp;&nbsp;--recommend roomy --why "Easier on a phone"</div>
          <div class="dim out">waiting for you…</div>
        </div>
        <div class="card">
          <h3>Which layout?</h3>
          <p class="rec-why"><b>Recommends Roomy.</b> {why}</p>
          <div class="opts">
            {options.map((o) => (
              <button class={`opt${o.id === recommend ? " rec" : ""}`} data-v={o.id}>
                <span class={`mini ${o.id}`}></span>
                <b>{o.label}</b>
                <small>{o.does}</small>
              </button>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <div class="wrap">
    <section class="kinds">
      <div class="kind"><span class="ico">🧪</span><b>Prototypes</b><span>Click the thing before it's built.</span></div>
      <div class="kind"><span class="ico">⚖️</span><b>Choices</b><span>Options side by side, with a pick and a reason.</span></div>
      <div class="kind"><span class="ico">🗺️</span><b>Plans</b><span>See the steps, steer the order.</span></div>
      <div class="kind"><span class="ico">📈</span><b>Dashboards</b><span>Live while the work runs.</span></div>
    </section>

    <section class="install" id="install">
      <h2>Get jelly</h2>
      <p class="sub">Runs on your machine. Works with any agent that has a shell.</p>
      <pre><span class="c"># install</span>
git clone {repo} && cd jelly
cargo install --path .

<span class="c"># teach your agent (Claude Code shown)</span>
ln -s "$PWD/skill" ~/.claude/skills/jelly

jelly ls   <span class="c"># your jelly page: http://127.0.0.1:7878</span></pre>
      <p class="sub agents">Are you an agent? Start at <a href="/llms.txt">/llms.txt</a>.</p>
    </section>

    <footer>
      <span>jelly is open source.</span>
      <a href={repo}>GitHub</a>
      <a href="/llms.txt">llms.txt</a>
      <span>Made with a lot of wobble.</span>
    </footer>
  </div>

  <script>
    const wobble = (el: Element, kind: "jig" | "hop") => {
      el.classList.remove("jig", "hop");
      void (el as HTMLElement).getBoundingClientRect();
      el.classList.add(kind);
    };
    document.addEventListener("click", (e) => {
      const blob = (e.target as Element).closest(".blob");
      if (blob) wobble(blob, "jig");
    });

    // The demo: tap an option, the "agent" hears it, every blob hops.
    const demo = document.getElementById("demo")!;
    const out = demo.querySelector(".out")!;
    demo.querySelectorAll<HTMLButtonElement>(".opt").forEach((o) =>
      o.addEventListener("click", () => {
        demo.querySelectorAll(".opt").forEach((x) => x.classList.toggle("picked", x === o));
        out.className = "ok out";
        out.textContent = `a1 answered: ${o.dataset.v} · by you, just now`;
        document.querySelectorAll(".blob").forEach((b) => wobble(b, "hop"));
      }),
    );
  </script>
</body>
</html>

<style is:global>
  * { box-sizing: border-box; }
  html { background: #fff8f3; color-scheme: light; scroll-behavior: smooth; }
  body { margin: 0; overflow-x: hidden; font: 16px/1.55 -apple-system, BlinkMacSystemFont, "Segoe UI", Inter, sans-serif; color: #2a1620; background: #fff8f3; }
  a { color: #a3134c; }
  .wrap { max-width: 1080px; margin: 0 auto; padding: 0 16px; }

  .blob { display: inline-block; transform-origin: 50% 90%; cursor: pointer; overflow: visible; }
  .blob .eyes { transform-origin: 20px 24px; animation: blink 5s infinite; }
  .blob.idle { animation: breathe 3.2s ease-in-out infinite; }
  .blob.hop { animation: hop 1s cubic-bezier(.3,1.6,.5,1); }
  .blob.jig { animation: jig .7s cubic-bezier(.3,1.6,.5,1); }
  @keyframes blink { 0%, 95%, 100% { transform: scaleY(1); } 97% { transform: scaleY(.1); } }
  @keyframes jig { 25% { transform: scale(1.18,.82); } 50% { transform: scale(.9,1.12); } 75% { transform: scale(1.05,.95); } }
  @keyframes hop { 30% { transform: translateY(-18%) scale(.9,1.12); } 60% { transform: translateY(0) scale(1.15,.85); } }
  @keyframes breathe { 50% { transform: scale(1.04,.96); } }

  nav { display: flex; align-items: center; gap: 18px; padding: 18px 0; }
  .brand { display: flex; align-items: center; gap: 8px; color: #2a1620; text-decoration: none; font-weight: 800; font-size: 22px; letter-spacing: -.03em; margin-right: auto; }
  .nav-link { color: #a3134c; text-decoration: none; font-weight: 600; }

  .hero { display: grid; grid-template-columns: 1.1fr .9fr; gap: 40px; align-items: center; padding: 40px 0 70px; }
  h1 { font-size: clamp(40px, 7vw, 76px); line-height: .98; letter-spacing: -.045em; margin: 0 0 18px; font-weight: 850; }
  h1 em { font-style: normal; color: #e8336f; display: inline-block; }
  h1 em:hover { animation: jig .7s cubic-bezier(.3,1.6,.5,1); }
  .lead { font-size: 19px; color: #5e4250; max-width: 34ch; margin: 0 0 26px; }
  .cta { display: flex; gap: 12px; flex-wrap: wrap; }
  .btn { display: inline-block; padding: 13px 22px; border-radius: 999px; font-weight: 700; text-decoration: none; }
  .btn.main { background: #e8336f; color: #fff; box-shadow: 0 8px 0 #a3134c; transition: transform .1s, box-shadow .1s; }
  .btn.main:active { transform: translateY(6px); box-shadow: 0 2px 0 #a3134c; }
  .btn.ghost { color: #a3134c; background: #ffe1ec; }
  .stage { position: relative; display: grid; place-items: center; }
  .stage .big { width: min(340px, 80vw); height: auto; filter: drop-shadow(0 30px 30px rgba(232,51,111,.25)); }
  .bubble { position: absolute; top: 4%; right: 0; background: #fff; border-radius: 18px 18px 18px 4px; padding: 10px 14px; font-weight: 600; font-size: 14px; box-shadow: 0 10px 30px -14px rgba(120,30,70,.5); }

  .band { background: #ffe1ec; padding: 70px 0; }
  h2 { font-size: clamp(28px, 4vw, 42px); letter-spacing: -.03em; margin: 0 0 10px; }
  .sub { color: #6b4f5c; margin: 0 0 24px; max-width: 52ch; }
  .split { display: grid; grid-template-columns: .9fr 1.1fr; gap: 30px; align-items: start; }

  .demo { display: grid; gap: 12px; }
  .term { background: #1b1220; color: #f6e8ef; border-radius: 14px; padding: 14px 16px; font: 12.5px/1.6 ui-monospace, "SF Mono", Menlo, monospace; overflow-x: auto; white-space: nowrap; }
  .term .p { color: #ff8fb4; }
  .term .dim { color: #b9a3b0; }
  .term .ok { color: #ffcf3f; }
  .card { background: #fff; border-radius: 16px; padding: 16px; box-shadow: 0 14px 40px -20px rgba(120,30,70,.45); border: 1px solid #f0dfe5; }
  .card h3 { margin: 0 0 6px; font-size: 16px; }
  .rec-why { margin: 0 0 12px; font-size: 13px; color: #6b4f5c; background: #fff1c7; border-radius: 10px; padding: 8px 10px; }
  .rec-why b { color: #5a3d00; }
  .opts { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; }
  .opt { border: 2px solid #f0dfe5; border-radius: 12px; padding: 8px; background: #fff; cursor: pointer; text-align: left; font: inherit; color: inherit; transition: transform .15s; }
  .opt:hover { transform: translateY(-2px); border-color: #ffb3cf; }
  .opt.rec { border-color: #ffcf3f; }
  .opt.picked { border-color: #e8336f; background: #ffe1ec; }
  .opt b { display: block; font-size: 14px; }
  .opt.rec b::after { content: "★"; color: #e0a800; margin-left: 4px; }
  .opt small { color: #6b4f5c; font-size: 12px; line-height: 1.3; display: block; }
  .mini { display: block; height: 38px; border-radius: 7px; margin-bottom: 6px; }
  .mini.dense { background: repeating-linear-gradient(#f3e3e8 0 5px, #fff 5px 8px); }
  .mini.roomy { background: linear-gradient(#ffb3cf 0 0) 6px 8px / 60% 7px no-repeat, linear-gradient(#ffcf3f 0 0) 6px 22px / 30% 9px no-repeat, #fff8f3; }
  .mini.cards { background: linear-gradient(#ffe1ec 0 0) 4px 4px / 44% 30px no-repeat, linear-gradient(#ffe1ec 0 0) right 4px top 4px / 44% 30px no-repeat, #fff; border: 1px solid #f3e3e8; }

  .kinds { display: grid; grid-template-columns: repeat(4, 1fr); gap: 14px; padding: 70px 0 30px; }
  .kind { background: #fff; border-radius: 20px; padding: 18px; border: 1px solid #f0dfe5; transition: transform .25s cubic-bezier(.3,1.6,.5,1); }
  .kind:nth-child(odd) { transform: rotate(-1.2deg); }
  .kind:nth-child(even) { transform: rotate(1deg); }
  .kind:hover { transform: rotate(0) scale(1.03,.98); }
  .kind .ico { font-size: 26px; }
  .kind b { display: block; margin: 6px 0 2px; }
  .kind span:last-child { color: #6b4f5c; font-size: 14px; }

  .install { padding: 50px 0 60px; }
  .install pre { margin: 0; background: #1b1220; color: #f6e8ef; border-radius: 14px; padding: 16px; font: 13px/1.6 ui-monospace, "SF Mono", Menlo, monospace; overflow-x: auto; }
  .install pre .c { color: #b9a3b0; }
  .agents { margin: 16px 0 0; }

  footer { border-top: 1px solid #f0dfe5; padding: 22px 0 40px; color: #6b4f5c; font-size: 14px; display: flex; gap: 16px; flex-wrap: wrap; }

  @media (max-width: 760px) {
    .hero, .split { grid-template-columns: 1fr; }
    .hero { padding-top: 10px; gap: 10px; }
    .stage { order: -1; }
    .stage .big { width: 180px; }
    .bubble { position: static; margin-bottom: 8px; }
    .kinds { grid-template-columns: 1fr 1fr; }
    .band { padding: 50px 0; }
  }
  @media (max-width: 420px) { .opts { grid-template-columns: 1fr; } .opt { display: grid; grid-template-columns: 60px 1fr; column-gap: 10px; } .mini { grid-row: span 2; margin: 0; } }
  @media (prefers-reduced-motion: reduce) { *, *::before, *::after { animation: none !important; transition: none !important; } html { scroll-behavior: auto; } }
</style>
