---
// The jelly logo. Tapping any blob jiggles it (see index.astro).
interface Props { size: number; class?: string; style?: string }
const { size, class: cls = "", style } = Astro.props;
---
<svg class={`blob ${cls}`} width={size} height={size} viewBox="0 0 40 40" role="img" aria-label="jelly" style={style}>
  <path d="M8 30 C4 22 6 10 20 9 C34 10 36 22 32 30 C29 35 11 35 8 30Z" fill="url(#blob-fill)" />
  <ellipse cx="15" cy="16" rx="4" ry="2.4" fill="#fff" opacity=".7" />
  <g class="eyes"><circle cx="16" cy="24" r="1.7" fill="#3b0a1e" /><circle cx="24" cy="24" r="1.7" fill="#3b0a1e" /></g>
  <path d="M18 27.5 Q20 29.3 22 27.5" stroke="#3b0a1e" stroke-width="1.3" fill="none" stroke-linecap="round" />
</svg>
