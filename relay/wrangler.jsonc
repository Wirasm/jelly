{
  "$schema": "node_modules/wrangler/config-schema.json",
  // The jelly relay: live share links for jellies. Each person deploys their own
  // (npm run deploy) and gets https://jelly-relay.<account>.workers.dev.
  "name": "jelly-relay",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  // One Durable Object per shared jelly (Live), and one for every PIN on the
  // relay (Pins), with SQLite storage (on the free plan too).
  "durable_objects": { "bindings": [{ "name": "LIVE", "class_name": "Live" }, { "name": "PINS", "class_name": "Pins" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Live"] }, { "tag": "v2", "new_sqlite_classes": ["Pins"] }]
  // RELAY_SECRET is a secret: `npx wrangler secret put RELAY_SECRET`. Only its holder can publish.
}
